// Regras de segurança do Cloud Firestore (ADR-005, RN02, RN11, RN12, RNF04) – esboço inicial.
// Publicar em: Console do Firebase > Firestore Database > Regras.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Backup dos dados locais de cada usuário: só o dono lê e escreve (RN02)
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // E-Desafio / E-Convite / E-Mensagem – ajustar ao implementar o UC04
    function participa(desafioId) {
      return exists(/databases/$(database)/documents/desafios/$(desafioId)/participantes/$(request.auth.uid));
    }

    match /desafios/{desafioId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && participa(desafioId);

      // RN12: participante só publica os próprios dias de progresso
      match /participantes/{uid} {
        allow read: if request.auth != null && participa(desafioId);
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nome', 'diasProgresso', 'dataIngresso']);
      }
      match /mensagens/{id} {
        allow read: if request.auth != null && participa(desafioId);
        allow create: if request.auth != null && participa(desafioId)
          && request.resource.data.autorId == request.auth.uid;
      }
      match /convites/{id} {
        allow read, write: if request.auth != null; // RN11: refinar (remetente participa / convidado é o usuário)
      }
    }
  }
}
